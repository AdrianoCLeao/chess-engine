{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chess Engine",
  "version": "0.1.0",
  "identifier": "com.adriano.chessengine",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Chess Engine",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Game",
    "shortDescription": "Engine de xadrez completa com bots Elo e modo treinador",
    "longDescription": "Aplicação desktop multiplataforma com engine própria, análise de lances estilo Chess.com, níveis Elo 100–3000 e documentação integrada."
  }
}
